{
  "name": "dsh-plugin-model-usage",
  "description": "Show the selected model's remaining usage beside the composer stats (GLM Coding Plan windows / DeepSeek balance)",
  "version": "0.2.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "cordis.patch.yml",
    "lib/index.js",
    "lib/client.js",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.0-rc.0 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
